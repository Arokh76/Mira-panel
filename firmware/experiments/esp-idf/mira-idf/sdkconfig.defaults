CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Regression: app_main -> recovery Wi-Fi + captive DNS + HTTP registration.
# Stock main stack is too small for this startup call chain on ESP-IDF 5.5.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
# HTTPS cameras: validate peer chain; never disable server certificate checks.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_DEF_REFR_PERIOD=10
# Preserve firmware-beta's GET /addlistlvgl query with styles/free layout.
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_20=y

CONFIG_LV_USE_SNAPSHOT=y

CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# esp_jpeg: software decoder required for RGB565 native LVGL buffers on ESP32-S3.
# Some ESP32 ROM JPEG decoders have fixed RGB888 output; never use it here.
CONFIG_JD_USE_ROM=n
CONFIG_JD_FORMAT_RGB565=y
CONFIG_JD_USE_SCALE=y
# Accept JPEG camera snapshots missing Huffman tables (common embedded cameras).
CONFIG_JD_DEFAULT_HUFFMAN=y

# Recover ESP32-S3 RGB DMA/PSRAM underflow horizontal drift at VSYNC.
# Leave known-good pixel clock and panel timings untouched.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
